new file mode 100644
index 0000000000000000000000000000000000000000..639e66f60b259f474b3768fddbf3515933cbac49
--- /dev/null
+++ b/apps/web/src/components/settings/CatFleetSettingsRow.browser.test.tsx
@@ -0,0 +1,28 @@
+import { DEFAULT_CLIENT_SETTINGS } from "@t3tools/contracts";
+import { expect, it, vi } from "vite-plus/test";
+
+import { render } from "../../../test/render";
+import { __setClientSettingsForTests, getClientSettings } from "../../hooks/useSettings";
+import { CatFleetSettingsRow } from "./CatFleetSettingsRow";
+
+it("picks how many cat planets show, and turns them off", async () => {
+  using stack = new DisposableStack();
+  const previousSettings = getClientSettings();
+  stack.defer(() => __setClientSettingsForTests(previousSettings));
+  __setClientSettingsForTests(DEFAULT_CLIENT_SETTINGS);
+  await using screen = await render(<CatFleetSettingsRow />);
+  const count = screen.getByRole("combobox", { name: "How many cat planets to show" });
+  const shown = screen.getByRole("switch", { name: "Show cat planets" });
+
+  // The row renders without the app stylesheet, so the switch has no size for a pointer to hit.
+  shown.element().dispatchEvent(new MouseEvent("click", { bubbles: true }));
+  await vi.waitFor(() => expect(getClientSettings().sidebarCatFleetEnabled).toBe(false));
+  await expect.element(count).toBeDisabled();
+  shown.element().dispatchEvent(new MouseEvent("click", { bubbles: true }));
+  await vi.waitFor(() => expect(getClientSettings().sidebarCatFleetEnabled).toBe(true));
+
+  await expect.element(count).toHaveTextContent("Up to 8");
+  await count.click();
+  await screen.getByRole("option", { name: "Up to 4" }).click();
+  await vi.waitFor(() => expect(getClientSettings().sidebarCatFleetLimit).toBe(4));
+});
diff --git a/apps/web/src/components/settings/CatFleetSettingsRow.tsx b/apps/web/src/components/settings/CatFleetSettingsRow.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9bd2f9eabf7cacdb22efc50e01bcec6b3ef85fd6
--- /dev/null
+++ b/apps/web/src/components/settings/CatFleetSettingsRow.tsx
@@ -0,0 +1,79 @@
+/* oxlint-disable t3code/no-untranslated-copy -- Catgirl Code setting, English only: upstream's catalogs stay untouched */
+import {
+  DEFAULT_CLIENT_SETTINGS,
+  MAX_SIDEBAR_CAT_FLEET_LIMIT,
+  type SidebarCatFleetLimit,
+} from "@t3tools/contracts/settings";
+
+import { updateClientSettings, useClientSettings } from "../../hooks/useSettings";
+import { Select, SelectItem, SelectPopup, SelectTrigger, SelectValue } from "../ui/select";
+import { Switch } from "../ui/switch";
+import { SettingResetButton, SettingsRow } from "./settingsLayout";
+
+// Whole rows of four at the usual sidebar width. The last choice shows every machine.
+const LIMITS: readonly SidebarCatFleetLimit[] = [4, 8, 12, 16, MAX_SIDEBAR_CAT_FLEET_LIMIT];
+
+/** Whether the sidebar draws machines as cat planets, and how many cells they may take. */
+export function CatFleetSettingsRow() {
+  const enabled = useClientSettings((s) => s.sidebarCatFleetEnabled);
+  const limit = useClientSettings((s) => s.sidebarCatFleetLimit);
+  const label = (value: number) => (value >= MAX_SIDEBAR_CAT_FLEET_LIMIT ? "All" : `Up to ${value}`);
+  const isDefault =
+    enabled === DEFAULT_CLIENT_SETTINGS.sidebarCatFleetEnabled &&
+    limit === DEFAULT_CLIENT_SETTINGS.sidebarCatFleetLimit;
+  return (
+    <SettingsRow
+      title="Cat planets"
+      description="Show your machines as cats at the top of the sidebar, busiest first. Running threads orbit them."
+      resetAction={
+        isDefault ? null : (
+          <SettingResetButton
+            ariaLabel="Reset cat planets to default"
+            onClick={() =>
+              updateClientSettings({
+                sidebarCatFleetEnabled: DEFAULT_CLIENT_SETTINGS.sidebarCatFleetEnabled,
+                sidebarCatFleetLimit: DEFAULT_CLIENT_SETTINGS.sidebarCatFleetLimit,
+              })
+            }
+          />
+        )
+      }
+      control={
+        <div className="flex w-full items-center gap-3 sm:w-auto">
+          <div className="min-w-0 flex-1 sm:w-28 sm:flex-none">
+            <Select
+              disabled={!enabled}
+              value={String(limit)}
+              onValueChange={(value) => {
+                const next = LIMITS.find((candidate) => String(candidate) === value);
+                if (next !== undefined) void updateClientSettings({ sidebarCatFleetLimit: next });
+              }}
+            >
+              <SelectTrigger
+                size="sm"
+                className="w-full min-w-0"
+                aria-label="How many cat planets to show"
+              >
+                <SelectValue>{label(limit)}</SelectValue>
+              </SelectTrigger>
+              <SelectPopup align="end" alignItemWithTrigger={false}>
+                {LIMITS.map((value) => (
+                  <SelectItem key={value} value={String(value)}>
+                    {label(value)}
+                  </SelectItem>
+                ))}
+              </SelectPopup>
+            </Select>
+          </div>
+          <Switch
+            checked={enabled}
+            onCheckedChange={(checked) =>
+              void updateClientSettings({ sidebarCatFleetEnabled: Boolean(checked) })
+            }
+            aria-label="Show cat planets"
+          />
+        </div>
+      }
+    />
+  );
+}
