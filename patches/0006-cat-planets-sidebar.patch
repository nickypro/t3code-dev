+/* Moons round the sidebar's cat planets. The arm turns and the moon turns back by the same
+   amount, so only transforms animate and each moon stays round on its squashed orbit. */
+@keyframes cat-orbit {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@utility cat-orbit-arm {
+  animation: cat-orbit var(--cat-orbit-period, 10s) linear infinite;
+  animation-delay: var(--cat-orbit-delay, 0s);
+  animation-play-state: var(--visible-animation-state, paused);
+}
+
+@utility cat-orbit-unspin {
+  animation: cat-orbit var(--cat-orbit-period, 10s) linear infinite reverse;
+  animation-delay: var(--cat-orbit-delay, 0s);
+  animation-play-state: var(--visible-animation-state, paused);
+}
+
 @keyframes live-activity-focus {
   from {
     transform: translateX(0);
