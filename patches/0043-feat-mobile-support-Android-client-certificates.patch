+          .Builder()
+          .url(server.url("/upload"))
+          .post("attachment bytes".toRequestBody())
+          .build()
+      client.newCall(upload).execute().close()
+      client.newCall(Request.Builder().url(server.url("/download")).build()).execute().use {
+        assertEquals("attachment bytes", it.body!!.string())
+      }
