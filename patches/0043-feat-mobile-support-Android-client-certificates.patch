+      .Builder()
+      .heldCertificate(serverIdentity, ca.certificate)
+      .addTrustedCertificate(ca.certificate)
+      .build()
+  private val clientTrust =
+    HandshakeCertificates.Builder().addTrustedCertificate(ca.certificate).build()
+
+  // A second hostname for the same local server, so tests can cross hosts without leaving it.
+  private val testDns =
+    object : Dns {
