+        val request = server.takeRequest(2, TimeUnit.SECONDS)!!
+        assertEquals(phone.certificate, request.handshake!!.peerCertificates.first())
+        if (index == 1) assertEquals("attachment bytes", request.body.readUtf8())
+      }
+      client.connectionPool.evictAll()
+    } finally {
+      server.shutdown()
+    }
+  }
+
+  @Test fun websocketStreamsWithTheSameIdentity() {
+    val server = server()
+    try {
+      server.enqueue(
+        MockResponse().withWebSocketUpgrade(
+          object : WebSocketListener() {
+            override fun onMessage(webSocket: WebSocket, text: String) {
+              webSocket.send("stream:$text")
+            }
+          }
+        )
+      )
+      val received = CountDownLatch(1)
+      var message: String? = null
+      val client = client(setOf(certificateOrigin(server.url("/").toString())!!))
+      val socket =
+        client.newWebSocket(
+          Request.Builder().url(server.url("/ws")).build(),
+          object : WebSocketListener() {
+            override fun onOpen(webSocket: WebSocket, response: Response) {
+              webSocket.send("hello")
+            }
+
+            override fun onMessage(webSocket: WebSocket, text: String) {
+              message = text
+              received.countDown()
+            }
+          }
+        )
+      assertTrue(received.await(5, TimeUnit.SECONDS))
+      assertEquals("stream:hello", message)
+      assertEquals(
+        phone.certificate,
+        server.takeRequest(2, TimeUnit.SECONDS)!!.handshake!!.peerCertificates.first()
+      )
+      socket.cancel()
+      client.dispatcher.executorService.shutdown()
