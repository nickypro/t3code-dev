+  }
+
+  @Test fun removingIdentityAndClosingItsSocketsPreventsAuthenticatedReuse() {
+    val server = server()
+    try {
+      val origins = mutableSetOf(certificateOrigin(server.url("/").toString())!!)
+      val sockets = mutableListOf<Socket>()
