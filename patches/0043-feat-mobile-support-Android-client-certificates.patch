+    }
+
+  private fun server(required: Boolean = true) = MockWebServer().apply {
+    useHttps(serverTls.sslSocketFactory(), false)
+    if (required) requireClientAuth() else requestClientAuth()
+    protocols = listOf(Protocol.HTTP_1_1)
+    start()
+  }
+
+  private fun identityTls(identity: HeldCertificate): SSLContext =
+    SSLContext.getInstance("TLS").apply {
+      val selected =
+        SelectedIdentity(
+          "phone",
+          identity.keyPair.private,
+          arrayOf(identity.certificate, ca.certificate)
+        )
+      init(arrayOf(selected), arrayOf(clientTrust.trustManager), null)
+    }
+
+  private fun client(
+    origins: Set<String>,
+    identity: HeldCertificate = phone,
+    tlsVersion: TlsVersion? = null,
+    opened: (String, Socket) -> Unit = { _, _ -> }
+  ): OkHttpClient {
+    val tls = identityTls(identity)
+    val socketFactory =
+      OriginSocketFactory(
+        clientTrust.sslSocketFactory(),
+        { origin -> if (origin in origins) tls.socketFactory else clientTrust.sslSocketFactory() },
+        opened
+      )
+    return OkHttpClient
+      .Builder()
+      .sslSocketFactory(socketFactory, clientTrust.trustManager)
+      .hostnameVerifier(originHostnameVerifier)
+      .apply {
+        if (tlsVersion != null) {
+          val spec =
