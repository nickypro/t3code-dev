diff --git a/apps/desktop/src/settings/DesktopConnectService.test.ts b/apps/desktop/src/settings/DesktopConnectService.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f4324480b7e212886863603360effcb23232a22
--- /dev/null
+++ b/apps/desktop/src/settings/DesktopConnectService.test.ts
@@ -0,0 +1,117 @@
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, describe, it } from "@effect/vitest";
+import type { ConnectServiceSettings } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+
+import * as DesktopConfig from "../app/DesktopConfig.ts";
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+import * as DesktopConnectService from "./DesktopConnectService.ts";
+
+const service: ConnectServiceSettings = {
+  relayUrl: "https://relay.example.test",
+  clerkPublishableKey: `pk_live_${btoa("clerk.example.test$")}`,
+  clerkJwtTemplate: "t3-relay",
+  clerkCliOAuthClientId: "cli-client",
+  source: "discovered",
+};
+
+const layerNode = Layer.mergeAll(NodeServices.layer, NodeCrypto.layer);
+
+/** One app launch: the service reads its file while this layer builds. */
+const launch = <A, E>(
+  baseDir: string,
+  use: (
+    connectService: DesktopConnectService.DesktopConnectService["Service"],
+  ) => Effect.Effect<A, E, DesktopEnvironment.DesktopEnvironment | FileSystem.FileSystem>,
+) =>
+  DesktopConnectService.DesktopConnectService.pipe(
+    Effect.flatMap(use),
+    Effect.provide(
+      DesktopConnectService.layer.pipe(
+        Layer.provideMerge(
+          DesktopEnvironment.layer({
+            dirname: "/repo/apps/desktop/src",
+            homeDirectory: baseDir,
+            platform: "darwin",
+            processArch: "x64",
+            appVersion: "1.2.3",
+            appPath: "/repo",
+            isPackaged: true,
+            resourcesPath: "/missing/resources",
+            runningUnderArm64Translation: false,
+          }).pipe(
+            Layer.provide(
+              Layer.mergeAll(layerNode, DesktopConfig.layerTest({ T3CODE_HOME: baseDir })),
+            ),
+          ),
+        ),
+        Layer.provideMerge(layerNode),
+      ),
+    ),
+  );
+
+const withHome = <A, E>(effect: (baseDir: string) => Effect.Effect<A, E, FileSystem.FileSystem>) =>
+  Effect.gen(function* () {
+    const fileSystem = yield* FileSystem.FileSystem;
+    return yield* effect(
+      yield* fileSystem.makeTempDirectoryScoped({ prefix: "t3-desktop-connect-service-test-" }),
+    );
+  }).pipe(Effect.provide(layerNode));
+
+describe("DesktopConnectService", () => {
+  it.effect("applies a saved service on the next launch and drops it on reset", () =>
+    withHome((baseDir) =>
+      Effect.gen(function* () {
+        const first = yield* launch(baseDir, (connectService) =>
+          connectService.save(service).pipe(Effect.as(connectService)),
+        );
+        // The launch that saved keeps running on what it started with.
+        assert.strictEqual(first.saved, null);
+        assert.deepStrictEqual(first.backendEnvironment, {});
+
+        const second = yield* launch(baseDir, (connectService) =>
+          connectService.save(null).pipe(Effect.as(connectService)),
+        );
+        assert.deepStrictEqual(second.saved, service);
+        assert.strictEqual(second.clerkFrontendApiHostname, "clerk.example.test");
+        assert.deepStrictEqual(second.backendEnvironment, {
+          T3CODE_RELAY_URL: "https://relay.example.test",
+          T3CODE_CLERK_PUBLISHABLE_KEY: service.clerkPublishableKey,
+          T3CODE_CLERK_JWT_TEMPLATE: "t3-relay",
+          T3CODE_CLERK_CLI_OAUTH_CLIENT_ID: "cli-client",
+        });
+
+        const third = yield* launch(baseDir, Effect.succeed);
+        assert.strictEqual(third.saved, null);
+        assert.strictEqual(third.clerkFrontendApiHostname, undefined);
+      }),
+    ),
+  );
+
+  it.effect("starts on the built-in service when the saved file is unusable", () =>
+    withHome((baseDir) =>
+      Effect.gen(function* () {
+        const fileSystem = yield* FileSystem.FileSystem;
+        const path = yield* launch(baseDir, () =>
+          Effect.map(DesktopEnvironment.DesktopEnvironment, (environment) =>
+            environment.path.join(environment.stateDir, "connect-service.json"),
+          ),
+        );
+        yield* fileSystem.makeDirectory(path.replace(/[^/\\]+$/u, ""), { recursive: true });
+        for (const contents of [
+          "{ not json",
+          JSON.stringify({ ...service, relayUrl: "http://relay.example.test" }),
+          JSON.stringify({ ...service, clerkPublishableKey: "sk_live_secret" }),
+        ]) {
+          yield* fileSystem.writeFileString(path, contents);
+          const launched = yield* launch(baseDir, Effect.succeed);
+          assert.strictEqual(launched.saved, null);
+          assert.deepStrictEqual(launched.backendEnvironment, {});
+        }
+      }),
+    ),
+  );
+});
diff --git a/apps/desktop/src/settings/DesktopConnectService.ts b/apps/desktop/src/settings/DesktopConnectService.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2f6f340c1c229a7adbecf208900b1ffe378ea7ca
--- /dev/null
+++ b/apps/desktop/src/settings/DesktopConnectService.ts
@@ -0,0 +1,107 @@
+import { ConnectServiceSettings } from "@t3tools/contracts";
+import {
+  connectServiceEnvironment,
+  parseConnectServiceSettings,
+  readConnectServiceSettings,
+} from "@t3tools/shared/connectService";
+import { clerkFrontendApiHostnameFromPublishableKey } from "@t3tools/shared/relayAuth";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+
+export class DesktopConnectServiceWriteError extends Schema.TaggedError<DesktopConnectServiceWriteError>()(
+  "DesktopConnectServiceWriteError",
+  {
+    path: Schema.String,
+    cause: Schema.Defect(),
+  },
+) {
+  override get message(): string {
+    return `Could not save the T3 Connect service at ${this.path}.`;
+  }
+}
+
+/**
+ * The T3 Connect service this device saved in place of the build's. Read once at startup: the
+ * window's security policy, the sign-in library and the local server all take it at launch,
+ * so a change applies by relaunching.
+ */
+export class DesktopConnectService extends Context.Service<
+  DesktopConnectService,
+  {
+    readonly saved: ConnectServiceSettings | null;
+    /** Undefined when nothing is saved, so callers fall back to the build's hostname. */
+    readonly clerkFrontendApiHostname: string | undefined;
+    readonly backendEnvironment: Readonly<Record<string, string>>;
+    readonly save: (
+      settings: ConnectServiceSettings | null,
+    ) => Effect.Effect<void, DesktopConnectServiceWriteError>;
+  }
+>()("@t3tools/desktop/settings/DesktopConnectService") {}
+
+const encodeSettingsJson = Schema.encodeEffect(Schema.fromJsonString(ConnectServiceSettings));
+
+const hostnameOf = (saved: ConnectServiceSettings | null): string | undefined => {
+  if (saved === null) return undefined;
+  try {
+    return clerkFrontendApiHostnameFromPublishableKey(saved.clerkPublishableKey);
+  } catch {
+    return undefined;
+  }
+};
+
+const of = (saved: ConnectServiceSettings | null, save: DesktopConnectService["Service"]["save"]) =>
+  DesktopConnectService.of({
+    saved,
+    clerkFrontendApiHostname: hostnameOf(saved),
+    backendEnvironment: connectServiceEnvironment(saved),
+    save,
+  });
+
+const make = Effect.gen(function* () {
+  const environment = yield* DesktopEnvironment.DesktopEnvironment;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const settingsPath = environment.path.join(environment.stateDir, "connect-service.json");
+
+  // An unreadable or invalid file means "nothing saved", so a bad value can never block startup.
+  const saved = yield* fileSystem.readFileString(settingsPath).pipe(
+    Effect.map((raw) => readConnectServiceSettings(parseConnectServiceSettings(raw))),
+    Effect.orElseSucceed(() => null),
+  );
+
+  return of(
+    saved,
+    Effect.fn("desktop.connectService.save")(function* (settings) {
+      const tempPath = `${settingsPath}.${process.pid}.tmp`;
+      const write =
+        settings === null
+          ? fileSystem.remove(settingsPath, { force: true })
+          : encodeSettingsJson(settings).pipe(
+              Effect.tap(() => fileSystem.makeDirectory(environment.stateDir, { recursive: true })),
+              Effect.flatMap((json) => fileSystem.writeFileString(tempPath, `${json}\n`)),
+              Effect.andThen(fileSystem.rename(tempPath, settingsPath)),
+              Effect.ensuring(fileSystem.remove(tempPath, { force: true }).pipe(Effect.ignore)),
+            );
+      yield* write.pipe(
+        Effect.mapError(
+          (cause) => new DesktopConnectServiceWriteError({ path: settingsPath, cause }),
+        ),
+      );
+    }),
+  );
+});
+
+export const layer = Layer.effect(DesktopConnectService, make);
+
+/**
+ * For code whose own tests build no settings layers. The app provides this service in the same
+ * layer as its other settings, so it is missing only in those tests, where nothing is saved.
+ */
+export const optional = Effect.serviceOption(DesktopConnectService).pipe(
+  Effect.map(Option.getOrUndefined),
+);
