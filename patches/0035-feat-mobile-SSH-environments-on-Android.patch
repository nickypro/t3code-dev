diff --git a/apps/mobile/src/connection/ssh/gateway.test.ts b/apps/mobile/src/connection/ssh/gateway.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ca858f9f53090a59901b3fca46ee1d438598d01a
--- /dev/null
+++ b/apps/mobile/src/connection/ssh/gateway.test.ts
@@ -0,0 +1,282 @@
+import { describe, expect, it } from "@effect/vitest";
+import {
+  AuthStandardClientScopes,
+  type DesktopSshEnvironmentTarget,
+  EnvironmentId,
+} from "@t3tools/contracts";
+import { targetConnectionKey } from "@t3tools/ssh/remoteScripts";
+import * as Effect from "effect/Effect";
+import { HttpClient } from "effect/http";
+import * as NodeCrypto from "node:crypto";
+import { vi } from "vite-plus/test";
+
+const http = vi.hoisted(() => ({
+  descriptor: vi.fn(),
+  exchange: vi.fn(),
+  session: vi.fn(),
+}));
+
+vi.mock("expo", () => ({ requireOptionalNativeModule: () => null }));
+vi.mock("@t3tools/client-runtime/environment", () => ({
+  fetchRemoteEnvironmentDescriptor: (input: unknown) => http.descriptor(input),
+}));
+vi.mock("@t3tools/client-runtime/authorization", () => ({
+  bootstrapRemoteBearerSession: (input: unknown) => http.exchange(input),
+  fetchRemoteSessionState: (input: unknown) => http.session(input),
+}));
+
+import { makeSshGateway } from "./gateway";
+import type { SshConnectResult, SshNative } from "./native";
+
+const CONFIG = `
+Host jump
+  HostName jump.example
+  User me
+Host box
+  HostName 127.0.0.1
+  Port 2222
+  User dev
+  ProxyJump jump
+`;
+const TARGET: DesktopSshEnvironmentTarget = {
+  alias: "box",
+  hostname: "127.0.0.1",
+  username: "dev",
+  port: 2222,
+};
+const ENVIRONMENT = EnvironmentId.make("env-box");
+const sha256Hex = async (text: string) =>
+  NodeCrypto.createHash("sha256").update(text).digest("hex");
+
+function setup(options: { readonly connect?: () => SshConnectResult } = {}) {
+  http.descriptor
+    .mockReset()
+    .mockImplementation(() => Effect.succeed({ environmentId: ENVIRONMENT, label: "box" }));
+  http.exchange.mockReset().mockImplementation(() => Effect.succeed({ access_token: "token-new" }));
+  http.session
+    .mockReset()
+    .mockImplementation(() =>
+      Effect.succeed({ authenticated: true, scopes: [...AuthStandardClientScopes] }),
+    );
+  const open = new Set<string>();
+  let sessions = 0;
+  const native = {
+    readConfig: vi.fn(async () => CONFIG),
+    connect: vi.fn(async (_hops: unknown): Promise<SshConnectResult> => {
+      if (options.connect) return options.connect();
+      const sessionId = `session-${++sessions}`;
+      open.add(sessionId);
+      return { status: "connected", sessionId };
+    }),
+    exec: vi.fn(async (_id: string, command: string, _stdin: string, _timeoutMs: number) =>
+      command.startsWith("sh -l -s")
+        ? { exitCode: 0, stdout: 'motd\n{"remotePort":3777,"serverKind":"external"}\n', stderr: "" }
+        : { exitCode: 0, stdout: '{"credential":"pairing-1"}\n', stderr: "" },
+    ),
+    forward: vi.fn(async (_id: string, _remotePort: number) => 41001),
+    isOpen: (id: string) => open.has(id),
+    close: vi.fn(async (id: string) => {
+      open.delete(id);
+    }),
+    trustHostKey: vi.fn(async () => undefined),
+  };
+  const gateway = makeSshGateway({
+    native: native as typeof native & SshNative,
+    httpClient: {} as HttpClient.HttpClient,
+    clientMetadata: { label: "Phone", os: "Android" },
+    sha256Hex,
+  });
+  return { native, open, gateway };
+}
+
+describe("mobile SSH gateway", () => {
+  it.effect("starts the server, forwards its port and pairs through the forward", () =>
+    Effect.gen(function* () {
+      const { native, gateway } = setup();
+      const ssh = yield* gateway;
+
+      const provisioned = yield* ssh.provision(TARGET);
+
+      const stateKey = (yield* Effect.promise(() => sha256Hex(targetConnectionKey(TARGET)))).slice(
+        0,
+        16,
+      );
+      expect(native.connect.mock.calls[0]?.[0]).toEqual([
+        { host: "jump.example", port: 22, user: "me", hostKeyAlias: null },
+        { host: "127.0.0.1", port: 2222, user: "dev", hostKeyAlias: null },
+      ]);
+      expect(native.exec.mock.calls.map((call) => call[1])).toEqual([
+        `sh -l -s -- ${stateKey}`,
+        "sh -s",
+      ]);
+      expect(native.forward).toHaveBeenCalledWith("session-1", 3777);
+      expect(http.exchange).toHaveBeenCalledWith(
+        expect.objectContaining({
+          httpBaseUrl: "http://127.0.0.1:41001/",
+          credential: "pairing-1",
+        }),
+      );
+      expect(provisioned).toMatchObject({
+        environmentId: ENVIRONMENT,
+        bearerToken: "token-new",
+        bootstrap: {
+          wsBaseUrl: "ws://127.0.0.1:41001/",
+          remotePort: 3777,
+          remoteServerKind: "external",
+        },
+      });
+    }),
+  );
+
+  it.effect("reuses the tunnel and a still-granted token without pairing again", () =>
+    Effect.gen(function* () {
+      const { native, gateway } = setup();
+      const ssh = yield* gateway;
+      yield* ssh.provision(TARGET);
+      native.exec.mockClear();
+
+      const prepared = yield* ssh.prepare({
+        connectionId: "ssh:env-box",
+        expectedEnvironmentId: ENVIRONMENT,
+        target: TARGET,
+        bearerToken: "token-saved",
+      });
+
+      expect(prepared.bearerToken).toBe("token-saved");
+      expect(native.connect).toHaveBeenCalledTimes(1);
+      expect(native.exec).not.toHaveBeenCalled();
+    }),
+  );
+
+  it.effect("pairs again when the saved token lost a standard scope", () =>
+    Effect.gen(function* () {
+      const { native, gateway } = setup();
+      const ssh = yield* gateway;
+      http.session.mockImplementation(() => Effect.succeed({ authenticated: true, scopes: [] }));
+
+      const prepared = yield* ssh.prepare({
+        connectionId: "ssh:env-box",
+        expectedEnvironmentId: ENVIRONMENT,
+        target: TARGET,
+        bearerToken: "token-old",
+      });
+
+      expect(prepared.bearerToken).toBe("token-new");
+      expect(native.exec.mock.calls.map((call) => call[1])).toContain("sh -s");
+    }),
+  );
+
+  it.effect("blocks on an untrusted host key instead of trusting it in the background", () =>
+    Effect.gen(function* () {
+      const { native, gateway } = setup({
+        connect: () => ({
+          status: "host-key-rejected",
+          host: "jump.example",
+          port: 22,
+          knownHostsName: "jump.example",
+          keyType: "ssh-ed25519",
+          fingerprint: "SHA256:x",
+          knownHostsLine: "jump.example ssh-ed25519 AAAA",
+          changed: true,
+        }),
+      });
+      const ssh = yield* gateway;
+
+      const error = yield* Effect.flip(
+        ssh.prepare({
+          connectionId: "c",
+          expectedEnvironmentId: ENVIRONMENT,
+          target: TARGET,
+          bearerToken: "t",
+        }),
+      );
+
+      expect(error).toMatchObject({ _tag: "ConnectionBlockedError", reason: "authentication" });
+      expect(native.trustHostKey).not.toHaveBeenCalled();
+    }),
+  );
+
+  it.effect("starts over after a failure instead of reusing a forward to a dead port", () =>
+    Effect.gen(function* () {
+      const { native, gateway } = setup();
+      const ssh = yield* gateway;
+      yield* ssh.provision(TARGET);
+      http.descriptor.mockImplementationOnce(() =>
+        Effect.fail({ _tag: "RemoteEnvironmentAuthFetchError", message: "connection refused" }),
+      );
+      const input = {
+        connectionId: "c",
+        expectedEnvironmentId: ENVIRONMENT,
+        target: TARGET,
+        bearerToken: "t",
+      };
+
+      const error = yield* Effect.flip(ssh.prepare(input));
+      expect(error).toMatchObject({ _tag: "ConnectionTransientError", reason: "network" });
+      expect(native.close).toHaveBeenCalledWith("session-1");
+
+      yield* ssh.prepare(input);
+      expect(native.connect).toHaveBeenCalledTimes(2);
+    }),
+  );
+
+  it.effect("replaces a session that died between attempts", () =>
+    Effect.gen(function* () {
+      const { native, open, gateway } = setup();
+      const ssh = yield* gateway;
+      yield* ssh.provision(TARGET);
+      open.clear();
+
+      yield* ssh.prepare({
+        connectionId: "c",
+        expectedEnvironmentId: ENVIRONMENT,
+        target: TARGET,
+        bearerToken: "t",
+      });
+
+      expect(native.connect).toHaveBeenCalledTimes(2);
+      expect(native.forward).toHaveBeenLastCalledWith("session-2", 3777);
+    }),
+  );
+
+  it.effect("refuses a host that turns out to be a different environment, before pairing", () =>
+    Effect.gen(function* () {
+      const { gateway } = setup();
+      const ssh = yield* gateway;
+      http.descriptor.mockImplementation(() =>
+        Effect.succeed({ environmentId: EnvironmentId.make("env-other"), label: "other" }),
+      );
+
+      const error = yield* Effect.flip(ssh.provision(TARGET, ENVIRONMENT));
+
+      expect(error).toMatchObject({ _tag: "ConnectionBlockedError", reason: "configuration" });
+      expect(http.exchange).not.toHaveBeenCalled();
+    }),
+  );
+
+  it.effect("explains a key the host does not accept", () =>
+    Effect.gen(function* () {
+      const { native, gateway } = setup();
+      native.connect.mockRejectedValueOnce(
+        Object.assign(new Error("auth"), { code: "ERR_SSH_AUTH" }),
+      );
+      const ssh = yield* gateway;
+
+      const error = yield* Effect.flip(ssh.provision(TARGET));
+
+      expect(error).toMatchObject({ _tag: "ConnectionBlockedError", reason: "authentication" });
+    }),
+  );
+
+  it.effect("disconnect closes the session", () =>
+    Effect.gen(function* () {
+      const { native, gateway } = setup();
+      const ssh = yield* gateway;
+      yield* ssh.provision(TARGET);
+
+      yield* ssh.disconnect(TARGET);
+
+      expect(native.close).toHaveBeenCalledWith("session-1");
+    }),
+  );
+});
diff --git a/apps/mobile/src/connection/ssh/gateway.ts b/apps/mobile/src/connection/ssh/gateway.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1159bd7f8de74db9c9a42c3a8f13d4e37c91d278
--- /dev/null
+++ b/apps/mobile/src/connection/ssh/gateway.ts
@@ -0,0 +1,308 @@
+import {
+  bootstrapRemoteBearerSession,
+  fetchRemoteSessionState,
+} from "@t3tools/client-runtime/authorization";
+import {
+  ConnectionBlockedError,
+  ConnectionTransientError,
+  mapRemoteEnvironmentError,
+  sshTargetKey,
+} from "@t3tools/client-runtime/connection";
+import { fetchRemoteEnvironmentDescriptor } from "@t3tools/client-runtime/environment";
+import { ClientCapabilities } from "@t3tools/client-runtime/platform";
+import {
+  type AuthClientPresentationMetadata,
+  AuthStandardClientScopes,
+  type DesktopSshEnvironmentBootstrap,
+  type DesktopSshEnvironmentTarget,
+  type EnvironmentId,
+} from "@t3tools/contracts";
+import * as KeyedLock from "@t3tools/shared/KeyedLock";
+import {
+  buildRemoteLaunchScript,
+  buildRemotePairingScript,
+  decodeRemoteLaunchOutput,
+  decodeRemotePairingOutput,
+  REMOTE_ARCHIVE_LAUNCH_TIMEOUT_MS,
+  targetConnectionKey,
+} from "@t3tools/ssh/remoteScripts";
+import * as Effect from "effect/Effect";
+import { HttpClient } from "effect/http";
+
+import { type SshNative, sshErrorCode } from "./native";
+import { parseSshConfig, resolveSshHost } from "./sshConfig";
+
+/**
+ * The t3 release a host is given when it has no server running yet. The desktop passes its
+ * own version here; keep this in step with the server version this build is paired with.
+ */
+export const REMOTE_T3_VERSION = "0.1.2";
+
+export interface SshGatewayDependencies {
+  readonly native: SshNative;
+  readonly httpClient: HttpClient.HttpClient;
+  readonly clientMetadata: AuthClientPresentationMetadata;
+  readonly sha256Hex: (text: string) => Promise<string>;
+}
+
+interface Tunnel {
+  readonly sessionId: string;
+  readonly stateKey: string;
+  readonly httpBaseUrl: string;
+  readonly wsBaseUrl: string;
+  readonly remotePort: number;
+  readonly remoteServerKind: "external" | "managed" | undefined;
+}
+
+const runner = { archiveVersion: REMOTE_T3_VERSION };
+
+/**
+ * The desktop's SSH environment flow, over the app's own SSH connection: run the launch
+ * script, forward its port to this device's loopback, and pair through the forward. Host keys
+ * are trusted only from Settings or while adding the host, never during a reconnect.
+ */
+export const makeSshGateway = Effect.fn("mobile.ssh.makeGateway")(function* (
+  deps: SshGatewayDependencies,
+) {
+  const { native } = deps;
+  const tunnels = new Map<string, Tunnel>();
+  const locks = yield* KeyedLock.make<string>();
+
+  const call = <A>(operation: () => Promise<A>) =>
+    Effect.tryPromise({ try: operation, catch: nativeError });
+
+  const dropTunnel = (key: string) =>
+    Effect.suspend(() => {
+      const tunnel = tunnels.get(key);
+      tunnels.delete(key);
+      return tunnel === undefined
+        ? Effect.void
+        : Effect.promise(() => native.close(tunnel.sessionId).catch(() => undefined));
+    });
+
+  const openTunnel = Effect.fn("mobile.ssh.openTunnel")(function* (
+    target: DesktopSshEnvironmentTarget,
+  ) {
+    const configText = yield* call(() => native.readConfig());
+    const resolved = yield* Effect.try({
+      try: () => resolveSshHost(parseSshConfig(configText), target.alias),
+      catch: (cause) =>
+        new ConnectionBlockedError({
+          reason: "configuration",
+          detail: cause instanceof Error ? cause.message : String(cause),
+        }),
+    });
+    const connected = yield* call(() => native.connect(resolved.hops));
+    if (connected.status === "host-key-rejected") {
+      return yield* new ConnectionBlockedError({
+        reason: "authentication",
+        detail: connected.changed
+          ? `The SSH host key for ${connected.knownHostsName} changed. If that is expected, remove the old key in Settings > SSH, then add the environment again.`
+          : `${connected.knownHostsName} is not trusted yet. Add the environment again to review its SSH host key.`,
+        hop: "tunnel",
+      });
+    }
+    const sessionId = connected.sessionId;
+    return yield* Effect.gen(function* () {
+      const stateKey = (yield* call(() => deps.sha256Hex(targetConnectionKey(target)))).slice(
+        0,
+        16,
+      );
+      const launch = yield* call(() =>
+        native.exec(
+          sessionId,
+          `sh -l -s -- ${stateKey}`,
+          buildRemoteLaunchScript(runner),
+          REMOTE_ARCHIVE_LAUNCH_TIMEOUT_MS,
+        ),
+      );
+      if (launch.exitCode !== 0) {
+        return yield* remoteFailure("start T3 Code on the host", launch.stderr);
+      }
+      const started = yield* decodeRemoteLaunchOutput(launch.stdout).pipe(
+        Effect.mapError(() => remoteFailureError("start T3 Code on the host", launch.stdout)),
+      );
+      const localPort = yield* call(() => native.forward(sessionId, started.remotePort));
+      return {
+        sessionId,
+        stateKey,
+        httpBaseUrl: `http://127.0.0.1:${localPort}/`,
+        wsBaseUrl: `ws://127.0.0.1:${localPort}/`,
+        remotePort: started.remotePort,
+        remoteServerKind: started.serverKind,
+      } satisfies Tunnel;
+    }).pipe(
+      Effect.onError(() => Effect.promise(() => native.close(sessionId).catch(() => undefined))),
+    );
+  });
+
+  const ensure = (target: DesktopSshEnvironmentTarget, options: { issuePairingToken: boolean }) => {
+    const key = sshTargetKey(target);
+    return locks.withLock(
+      key,
+      Effect.gen(function* () {
+        let tunnel = tunnels.get(key);
+        if (tunnel !== undefined && !native.isOpen(tunnel.sessionId)) {
+          yield* dropTunnel(key);
+          tunnel = undefined;
+        }
+        if (tunnel === undefined) {
+          tunnel = yield* openTunnel(target);
+          tunnels.set(key, tunnel);
+        }
+        let pairingToken: string | null = null;
+        if (options.issuePairingToken) {
+          const { sessionId, stateKey } = tunnel;
+          const pairing = yield* call(() =>
+            native.exec(
+              sessionId,
+              "sh -s",
+              buildRemotePairingScript(stateKey, runner),
+              REMOTE_ARCHIVE_LAUNCH_TIMEOUT_MS,
+            ),
+          );
+          if (pairing.exitCode !== 0) {
+            return yield* remoteFailure("issue a pairing credential", pairing.stderr);
+          }
+          pairingToken = (yield* decodeRemotePairingOutput(pairing.stdout).pipe(
+            Effect.mapError(() => remoteFailureError("issue a pairing credential", pairing.stdout)),
+          )).credential;
+        }
+        return {
+          target,
+          httpBaseUrl: tunnel.httpBaseUrl,
+          wsBaseUrl: tunnel.wsBaseUrl,
+          pairingToken,
+          remotePort: tunnel.remotePort,
+          ...(tunnel.remoteServerKind === undefined
+            ? {}
+            : { remoteServerKind: tunnel.remoteServerKind }),
+        } satisfies DesktopSshEnvironmentBootstrap;
+      }),
+    );
+  };
+
+  const describe = Effect.fn("mobile.ssh.describe")(function* (
+    httpBaseUrl: string,
+    target: DesktopSshEnvironmentTarget,
+    expected?: EnvironmentId,
+  ) {
+    const descriptor = yield* fetchRemoteEnvironmentDescriptor({ httpBaseUrl }).pipe(
+      Effect.mapError((error) => mapRemoteEnvironmentError(error)),
+    );
+    if (expected !== undefined && descriptor.environmentId !== expected) {
+      return yield* new ConnectionBlockedError({
+        reason: "configuration",
+        detail: `${target.alias} reaches ${descriptor.label}, a different machine. Add it as its own environment instead.`,
+      });
+    }
+    return descriptor;
+  });
+
+  const provision = Effect.fn("mobile.ssh.provision")(function* (
+    target: DesktopSshEnvironmentTarget,
+    expectedEnvironmentId?: EnvironmentId,
+  ) {
+    const bootstrap = yield* ensure(target, { issuePairingToken: true });
+    const credential = bootstrap.pairingToken;
+    if (credential === null) {
+      return yield* remoteFailure("issue a pairing credential", "");
+    }
+    const descriptor = yield* describe(bootstrap.httpBaseUrl, target, expectedEnvironmentId);
+    const access = yield* bootstrapRemoteBearerSession({
+      httpBaseUrl: bootstrap.httpBaseUrl,
+      credential,
+      clientMetadata: deps.clientMetadata,
+    }).pipe(Effect.mapError((error) => mapRemoteEnvironmentError(error)));
+    return {
+      environmentId: descriptor.environmentId,
+      label: descriptor.label,
+      bootstrap,
+      bearerToken: access.access_token,
+    };
+  });
+
+  // Every pairing adds a session on the host, so a saved token is kept while the host still
+  // grants it every standard scope.
+  const prepare = Effect.fn("mobile.ssh.prepare")(function* (input: {
+    readonly connectionId: string;
+    readonly expectedEnvironmentId: EnvironmentId;
+    readonly target: DesktopSshEnvironmentTarget;
+    readonly bearerToken?: string;
+  }) {
+    const bearerToken = input.bearerToken;
+    if (bearerToken !== undefined) {
+      const bootstrap = yield* ensure(input.target, { issuePairingToken: false });
+      yield* describe(bootstrap.httpBaseUrl, input.target, input.expectedEnvironmentId);
+      const session = yield* fetchRemoteSessionState({
+        httpBaseUrl: bootstrap.httpBaseUrl,
+        bearerToken,
+      }).pipe(Effect.mapError((error) => mapRemoteEnvironmentError(error)));
+      const granted = session.permissions ?? session.scopes ?? [];
+      if (
+        session.authenticated &&
+        AuthStandardClientScopes.every((scope) => granted.includes(scope))
+      ) {
+        return { bootstrap, bearerToken };
+      }
+    }
+    const provisioned = yield* provision(input.target, input.expectedEnvironmentId);
+    return { bootstrap: provisioned.bootstrap, bearerToken: provisioned.bearerToken };
+  });
+
+  // A failure after the tunnel opened may mean the host's server moved or stopped, so the next
+  // attempt starts over instead of reusing a forward to a dead port.
+  const resetOnFailure =
+    (target: DesktopSshEnvironmentTarget) =>
+    <A, E>(effect: Effect.Effect<A, E, HttpClient.HttpClient>) =>
+      effect.pipe(
+        Effect.onError(() => dropTunnel(sshTargetKey(target))),
+        Effect.provideService(HttpClient.HttpClient, deps.httpClient),
+      );
+
+  return ClientCapabilities.SshEnvironmentGateway.of({
+    provision: (target, expectedEnvironmentId) =>
+      provision(target, expectedEnvironmentId).pipe(resetOnFailure(target)),
+    prepare: (input) => prepare(input).pipe(resetOnFailure(input.target)),
+    disconnect: (target) => dropTunnel(sshTargetKey(target)),
+  });
+});
+
+function nativeError(cause: unknown) {
+  const message = cause instanceof Error ? cause.message : String(cause);
+  switch (sshErrorCode(cause)) {
+    case "ERR_SSH_AUTH":
+      return new ConnectionBlockedError({
+        reason: "authentication",
+        detail:
+          "The host did not accept this device's SSH key. Add the key from Settings > SSH to its authorized_keys.",
+        hop: "tunnel",
+      });
+    case "ERR_SSH_NO_KEY":
+      return new ConnectionBlockedError({
+        reason: "configuration",
+        detail: "Create an SSH key in Settings > SSH first.",
+        hop: "device",
+      });
+    case "ERR_SSH_UNREACHABLE":
+      return new ConnectionTransientError({ reason: "network", detail: message, hop: "tunnel" });
+    default:
+      return new ConnectionTransientError({
+        reason: "remote-unavailable",
+        detail: `Could not prepare the SSH environment: ${message}`,
+        hop: "tunnel",
+      });
+  }
+}
+
+function remoteFailureError(action: string, output: string) {
+  const tail = output.trim().split("\n").slice(-3).join("\n");
+  return new ConnectionTransientError({
+    reason: "remote-unavailable",
+    detail: `Could not ${action}${tail === "" ? "." : `: ${tail}`}`,
+    hop: "server",
+  });
+}
+
+const remoteFailure = (action: string, output: string) =>
+  Effect.fail(remoteFailureError(action, output));
