index 0000000000000000000000000000000000000000..d0055b0fa1b2fe060e2bca763ee6e44cf91d7c8c
--- /dev/null
+++ b/apps/mobile/src/connection/ssh/hostKeys.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it, vi } from "vite-plus/test";
+
+import { reviewHostKeys, SshHostKeyChangedError } from "./hostKeys";
+import type { SshConnectResult, SshHop, SshHostKeyRejection, SshNative } from "./native";
+
+const HOPS: ReadonlyArray<SshHop> = [
+  { host: "jump.example", port: 22, user: "me", hostKeyAlias: null },
+  { host: "127.0.0.1", port: 2222, user: "dev", hostKeyAlias: "box" },
+];
+
+function rejection(name: string, changed = false): SshHostKeyRejection {
+  return {
+    status: "host-key-rejected",
+    host: name,
+    port: 22,
+    knownHostsName: name,
+    keyType: "ssh-ed25519",
+    fingerprint: `SHA256:${name}`,
+    knownHostsLine: `${name} ssh-ed25519 AAAA`,
+    changed,
+  };
+}
+
+function fakeNative(results: ReadonlyArray<SshConnectResult>) {
+  const queue = [...results];
+  const native = {
+    connect: vi.fn(async () => queue.shift() ?? { status: "connected" as const, sessionId: "s" }),
+    trustHostKey: vi.fn(async (_line: string) => undefined),
+    close: vi.fn(async (_id: string) => undefined),
+  };
+  return native as typeof native & SshNative;
+}
+
+describe("reviewHostKeys", () => {
+  it("asks about each new hop in order, then closes the check connection", async () => {
+    const native = fakeNative([rejection("jump.example"), rejection("box")]);
+    const asked: string[] = [];
+
+    const trusted = await reviewHostKeys(native, HOPS, async (key) => {
+      asked.push(key.knownHostsName);
+      return true;
+    });
+
+    expect(trusted).toBe(true);
+    expect(asked).toEqual(["jump.example", "box"]);
+    expect(native.trustHostKey.mock.calls).toEqual([
+      ["jump.example ssh-ed25519 AAAA"],
+      ["box ssh-ed25519 AAAA"],
+    ]);
+    expect(native.close).toHaveBeenCalledWith("s");
+  });
+
+  it("trusts nothing when the user declines", async () => {
+    const native = fakeNative([rejection("jump.example")]);
+
+    expect(await reviewHostKeys(native, HOPS, async () => false)).toBe(false);
+    expect(native.trustHostKey).not.toHaveBeenCalled();
+  });
+
+  it("never offers a changed key for trust", async () => {
+    const native = fakeNative([rejection("box", true)]);
+    const confirm = vi.fn(async () => true);
+
+    await expect(reviewHostKeys(native, HOPS, confirm)).rejects.toBeInstanceOf(
+      SshHostKeyChangedError,
+    );
+    expect(confirm).not.toHaveBeenCalled();
+    expect(native.trustHostKey).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/mobile/src/connection/ssh/hostKeys.ts b/apps/mobile/src/connection/ssh/hostKeys.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d6d831779080ecd55cd8a8a418b18cba355d9861
--- /dev/null
+++ b/apps/mobile/src/connection/ssh/hostKeys.ts
@@ -0,0 +1,34 @@
+import type { SshHop, SshHostKeyRejection, SshNative } from "./native";
+
+export class SshHostKeyChangedError extends Error {
+  constructor(readonly rejection: SshHostKeyRejection) {
+    super(
+      `The SSH host key for ${rejection.knownHostsName} changed. If that is expected, remove the old key in Settings > SSH and try again.`,
+    );
+  }
+}
+
+/**
+ * Connects once to check every hop's host key, asking before trusting one it has not seen.
+ * A key that differs from the trusted one is never offered for trust here. Resolves false if
+ * the user declines; signing in with the device key happens on the same connection, so a key
+ * the host does not accept rejects with `ERR_SSH_AUTH`.
+ */
+export async function reviewHostKeys(
+  native: SshNative,
+  hops: ReadonlyArray<SshHop>,
+  confirmTrust: (rejection: SshHostKeyRejection) => Promise<boolean>,
+): Promise<boolean> {
+  // Each pass gets one hop further, so this is bounded by the number of hops.
+  for (let pass = 0; pass <= hops.length; pass++) {
+    const result = await native.connect(hops);
+    if (result.status === "connected") {
+      await native.close(result.sessionId);
+      return true;
+    }
+    if (result.changed) throw new SshHostKeyChangedError(result);
+    if (!(await confirmTrust(result))) return false;
+    await native.trustHostKey(result.knownHostsLine);
+  }
+  throw new Error("The SSH host keys did not settle; try again.");
+}
diff --git a/apps/mobile/src/connection/ssh/native.ts b/apps/mobile/src/connection/ssh/native.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3d8b3451a2804197b18ebc457501ece9e9f7c7d8
--- /dev/null
+++ b/apps/mobile/src/connection/ssh/native.ts
@@ -0,0 +1,76 @@
+import { requireOptionalNativeModule } from "expo";
+
+export interface SshPublicKey {
+  readonly line: string;
+  readonly fingerprint: string;
+}
+
+export interface SshKnownHost {
+  readonly line: string;
+  readonly names: ReadonlyArray<string>;
+  readonly keyType: string;
+  readonly fingerprint: string;
+}
+
+export interface SshHop {
+  readonly host: string;
+  readonly port: number;
+  readonly user: string;
+  readonly hostKeyAlias: string | null;
+}
+
+export interface SshHostKeyRejection {
+  readonly status: "host-key-rejected";
+  readonly host: string;
+  readonly port: number;
+  readonly knownHostsName: string;
+  readonly keyType: string;
+  readonly fingerprint: string;
+  readonly knownHostsLine: string;
+  /** known_hosts already holds a different key under this name. */
+  readonly changed: boolean;
+}
+
+export type SshConnectResult =
+  | { readonly status: "connected"; readonly sessionId: string }
+  | SshHostKeyRejection;
+
+export interface SshExecResult {
+  readonly exitCode: number | null;
+  readonly stdout: string;
+  readonly stderr: string;
+}
+
+/** `modules/t3-ssh`. The private key stays native; failures reject with an `ERR_SSH_*` code. */
+export interface SshNative {
+  getPublicKey(): Promise<SshPublicKey | null>;
+  createKey(comment: string): Promise<SshPublicKey>;
+  deleteKey(): Promise<void>;
+  readConfig(): Promise<string>;
+  writeConfig(text: string): Promise<void>;
+  listKnownHosts(): Promise<ReadonlyArray<SshKnownHost>>;
+  trustHostKey(line: string): Promise<void>;
+  forgetHostKey(line: string): Promise<void>;
+  connect(hops: ReadonlyArray<SshHop>): Promise<SshConnectResult>;
+  exec(
+    sessionId: string,
+    command: string,
+    stdin: string,
+    timeoutMs: number,
+  ): Promise<SshExecResult>;
+  forward(sessionId: string, remotePort: number): Promise<number>;
+  isOpen(sessionId: string): boolean;
+  close(sessionId: string): Promise<void>;
+}
+
+/** Null where the platform has no SSH module (iOS). */
+export const sshNative = requireOptionalNativeModule<SshNative>("T3Ssh");
+
+export function sshErrorCode(cause: unknown): string | null {
+  return typeof cause === "object" &&
+    cause !== null &&
+    "code" in cause &&
+    typeof cause.code === "string"
+    ? cause.code
+    : null;
+}
diff --git a/apps/mobile/src/connection/ssh/sshConfig.test.ts b/apps/mobile/src/connection/ssh/sshConfig.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d671bf9133695bda3e6bc81c132a6213948f920f
--- /dev/null
+++ b/apps/mobile/src/connection/ssh/sshConfig.test.ts
@@ -0,0 +1,109 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { parseSshConfig, resolveSshHost } from "./sshConfig";
+
+const BOX = `
+# The research box: the host's sshd, then the container's on its loopback.
+Host slop
+  HostName slop.example
+  User nicky
+
+Host slop-box
+  HostName 127.0.0.1
+  Port 2222
+  User dev
+  HostKeyAlias slop-box
+  ProxyJump slop
+  ForwardAgent no
+`;
+
+describe("parseSshConfig / resolveSshHost", () => {
+  it("resolves a ProxyJump chain, jump host first", () => {
+    expect(resolveSshHost(parseSshConfig(BOX), "slop-box")).toEqual({
+      hops: [
+        { host: "slop.example", port: 22, user: "nicky", hostKeyAlias: null },
+        { host: "127.0.0.1", port: 2222, user: "dev", hostKeyAlias: "slop-box" },
+      ],
+      target: { alias: "slop-box", hostname: "127.0.0.1", username: "dev", port: 2222 },
+    });
+  });
+
+  it("follows a jump host's own ProxyJump and literal user@host:port jumps", () => {
+    const config = parseSshConfig(`
+Host inner
+  User root
+  ProxyJump outer,ops@[2001:db8::1]:2200
+Host outer
+  HostName outer.example
+  User me
+  ProxyJump gate@gate.example
+`);
+
+    expect(resolveSshHost(config, "inner").hops).toEqual([
+      { host: "gate.example", port: 22, user: "gate", hostKeyAlias: null },
+      { host: "outer.example", port: 22, user: "me", hostKeyAlias: null },
+      { host: "2001:db8::1", port: 2200, user: "ops", hostKeyAlias: null },
+      { host: "inner", port: 22, user: "root", hostKeyAlias: null },
+    ]);
+  });
+
+  it("keeps the first value for a setting, as OpenSSH does", () => {
+    const config = parseSshConfig(`
+Host a b
+  User first
+Host a
+  User second
+  Port=2200
+`);
+
+    expect(resolveSshHost(config, "a").target).toEqual({
+      alias: "a",
+      hostname: "a",
+      username: "first",
+      port: 2200,
+    });
+    expect(resolveSshHost(config, "b").target.username).toBe("first");
+  });
+
+  it("ignores pattern and Match blocks and says so", () => {
+    const config = parseSshConfig(`
+Host *
+  User everyone
+Host box
+  HostName box.example
+Match host box
+  User matched
+`);
+
+    expect(config.problems).toHaveLength(2);
+    expect(() => resolveSshHost(config, "box")).toThrow("Add a User line for box.");
+  });
+
+  it("reports unusable configurations", () => {
+    const config = parseSshConfig(`
+Host loop-a
+  User u
+  ProxyJump loop-b
+Host loop-b
+  User u
+  ProxyJump loop-a
+Host bad-port
+  User u
+  Port 99999
+  ProxyCommand nc %h %p
+`);
+
+    expect(() => resolveSshHost(config, "loop-a")).toThrow("ProxyJump loops back to loop-a.");
+    expect(() => resolveSshHost(config, "missing")).toThrow("No Host missing in the SSH config.");
+    expect(config.problems).toEqual([
+      'Line 10: "99999" is not a port.',
+      "Line 11: ProxyCommand is not supported; use ProxyJump.",
+    ]);
+  });
+
+  it("treats ProxyJump none as a direct connection", () => {
+    const config = parseSshConfig("Host direct\n  User u\n  ProxyJump none\n");
+
+    expect(resolveSshHost(config, "direct").hops).toHaveLength(1);
+  });
+});
diff --git a/apps/mobile/src/connection/ssh/sshConfig.ts b/apps/mobile/src/connection/ssh/sshConfig.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b60138a57e04c52d487204ccdbf4a35c900bdabd
--- /dev/null
+++ b/apps/mobile/src/connection/ssh/sshConfig.ts
@@ -0,0 +1,167 @@
+import type { DesktopSshEnvironmentTarget } from "@t3tools/contracts";
+
+import type { SshHop } from "./native";
+
+/**
+ * The part of ssh_config(5) the app understands: literal `Host` blocks with HostName, User,
+ * Port, ProxyJump and HostKeyAlias. As in OpenSSH, the first value found for a setting wins.
+ * Anything else is ignored, and the settings that would change where a connection goes are
+ * reported so the user is not surprised.
+ */
+export interface SshConfigHost {
+  readonly alias: string;
+  readonly hostname: string | null;
+  readonly user: string | null;
+  readonly port: number | null;
+  readonly proxyJump: ReadonlyArray<string> | null;
+  readonly hostKeyAlias: string | null;
+}
+
+export interface SshConfig {
+  readonly hosts: ReadonlyArray<SshConfigHost>;
+  readonly problems: ReadonlyArray<string>;
+}
+
+export interface ResolvedSshHost {
+  readonly hops: ReadonlyArray<SshHop>;
+  readonly target: DesktopSshEnvironmentTarget;
+}
+
+const MAX_HOPS = 8;
+const UNSUPPORTED = new Map([
+  ["match", "Match blocks are not supported; their settings are ignored."],
+  ["include", "Include is not supported."],
+  ["proxycommand", "ProxyCommand is not supported; use ProxyJump."],
+]);
+
+type MutableHost = { -readonly [K in keyof SshConfigHost]: SshConfigHost[K] };
+
+export function parseSshConfig(text: string): SshConfig {
+  const hosts = new Map<string, MutableHost>();
+  const problems: string[] = [];
+  // null while outside a literal Host block (before the first one, or in `Host *` / Match).
+  let current: MutableHost[] | null = null;
+
+  for (const [index, raw] of text.split(/\r?\n/u).entries()) {
+    const line = raw.trim();
+    if (line === "" || line.startsWith("#")) continue;
+    const match = /^(\S+?)(?:\s*=\s*|\s+)(.*)$/u.exec(line);
+    const keyword = (match?.[1] ?? line).toLowerCase();
+    const value = (match?.[2] ?? "").trim();
+    const where = `Line ${index + 1}`;
+
+    if (keyword === "host") {
+      const names = value.split(/\s+/u).filter((name) => name !== "");
+      const literal = names.filter((name) => !/[*?!]/u.test(name));
+      if (literal.length < names.length) {
+        problems.push(`${where}: patterns like "${names.join(" ")}" are ignored; name each host.`);
+      }
+      current = literal.map((alias) => {
+        const existing = hosts.get(alias);
+        if (existing) return existing;
+        const created: MutableHost = {
+          alias,
+          hostname: null,
+          user: null,
+          port: null,
+          proxyJump: null,
+          hostKeyAlias: null,
+        };
+        hosts.set(alias, created);
+        return created;
+      });
+      continue;
+    }
+    const unsupported = UNSUPPORTED.get(keyword);
+    if (unsupported !== undefined) {
+      problems.push(`${where}: ${unsupported}`);
+      if (keyword === "match") current = null;
+      continue;
+    }
+    if (current === null) continue;
+    for (const host of current) applySetting(host, keyword, value, where, problems);
+  }
+  return { hosts: [...hosts.values()], problems };
+}
+
+function applySetting(
+  host: MutableHost,
+  keyword: string,
+  value: string,
+  where: string,
+  problems: string[],
+) {
+  switch (keyword) {
+    case "hostname":
+      host.hostname ??= value;
+      return;
+    case "user":
+      host.user ??= value;
+      return;
+    case "hostkeyalias":
+      host.hostKeyAlias ??= value;
+      return;
+    case "port": {
+      const port = Number(value);
+      if (!Number.isInteger(port) || port < 1 || port > 65_535) {
+        problems.push(`${where}: "${value}" is not a port.`);
+        return;
+      }
+      host.port ??= port;
+      return;
+    }
+    case "proxyjump":
+      host.proxyJump ??=
+        value.toLowerCase() === "none" ? [] : value.split(",").map((jump) => jump.trim());
+      return;
+  }
+}
+
+/** The hops to reach `alias`, jump hosts first, following each jump host's own ProxyJump. */
+export function resolveSshHost(config: SshConfig, alias: string): ResolvedSshHost {
+  const byAlias = new Map(config.hosts.map((host) => [host.alias, host]));
+  const hops: SshHop[] = [];
+
+  const visit = (name: string, chain: ReadonlyArray<string>) => {
+    if (chain.includes(name)) {
+      throw new Error(`ProxyJump loops back to ${name}.`);
+    }
+    const host = byAlias.get(name) ?? literalHost(name);
+    for (const jump of host.proxyJump ?? []) visit(jump, [...chain, name]);
+    if (hops.length >= MAX_HOPS) throw new Error(`${alias} needs more than ${MAX_HOPS} hops.`);
+    if (host.user === null || host.user === "") {
+      throw new Error(`Add a User line for ${host.alias}.`);
+    }
+    hops.push({
+      host: host.hostname ?? host.alias,
+      port: host.port ?? 22,
+      user: host.user,
+      hostKeyAlias: host.hostKeyAlias,
+    });
+  };
+
+  if (!byAlias.has(alias)) throw new Error(`No Host ${alias} in the SSH config.`);
+  visit(alias, []);
+  const last = hops[hops.length - 1];
+  if (last === undefined) throw new Error(`No Host ${alias} in the SSH config.`);
+  return {
+    hops,
+    target: { alias, hostname: last.host, username: last.user, port: last.port },
+  };
+}
+
+/** A ProxyJump entry that names no Host block: `[user@]host[:port]`, IPv6 in brackets. */
+function literalHost(spec: string): SshConfigHost {
+  const match = /^(?:([^@]+)@)?(?:\[([^\]]+)\]|([^:]+))(?::(\d+))?$/u.exec(spec);
+  if (match === null)
+    throw new Error(`"${spec}" is neither a Host in the config nor user@host:port.`);
+  const port = match[4] === undefined ? null : Number(match[4]);
+  return {
+    alias: spec,
+    hostname: match[2] ?? match[3] ?? spec,
+    user: match[1] ?? null,
+    port,
+    proxyJump: null,
+    hostKeyAlias: null,
+  };
+}
